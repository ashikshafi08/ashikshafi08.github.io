#!/bin/bash

# Quick post creator for daily writing
# Usage:
#   ./bin/new post "Title of my blog post"
#   ./bin/new til "What I learned today"
#   ./bin/new now "Quick update about what I'm doing"

set -e

TYPE=$1
TITLE=$2
DATE=$(date +%Y-%m-%d)
SLUG=$(echo "$TITLE" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd '[:alnum:]-')

if [ -z "$TYPE" ] || [ -z "$TITLE" ]; then
    echo "Usage: ./bin/new <type> <title>"
    echo ""
    echo "Types:"
    echo "  post  - Full blog post (tech deep-dives, tutorials)"
    echo "  til   - Today I Learned (quick insights, 2-5 min read)"
    echo "  now   - Daily log entry (what you're working on)"
    echo ""
    echo "Examples:"
    echo "  ./bin/new post \"Building RAG Systems with LangChain\""
    echo "  ./bin/new til \"Python walrus operator\""
    echo "  ./bin/new now \"Shipped the new API endpoint\""
    exit 1
fi

case $TYPE in
    post)
        FILE="_posts/${DATE}-${SLUG}.md"
        cat > "$FILE" << EOF
---
layout: post
title: "${TITLE}"
date: ${DATE}
description:
tags:
categories:
---

<!-- Write your post here -->


EOF
        echo "Created blog post: $FILE"
        ;;

    til)
        FILE="_posts/${DATE}-til-${SLUG}.md"
        cat > "$FILE" << EOF
---
layout: post
title: "TIL: ${TITLE}"
date: ${DATE}
description: Quick insight about ${TITLE}
tags: til
categories: til
---

<!-- What did you learn? Keep it short and useful -->


## The Problem


## The Solution


## Why It Matters

EOF
        echo "Created TIL: $FILE"
        ;;

    now)
        FILE="_now/${DATE}-${SLUG}.md"
        cat > "$FILE" << EOF
---
title: "${TITLE}"
date: ${DATE}
---

<!-- Quick update - what are you working on? -->

EOF
        echo "Created now entry: $FILE"
        ;;

    *)
        echo "Unknown type: $TYPE"
        echo "Valid types: post, til, now"
        exit 1
        ;;
esac

# Open in default editor if EDITOR is set, otherwise try common editors
if [ -n "$EDITOR" ]; then
    $EDITOR "$FILE"
elif command -v code &> /dev/null; then
    code "$FILE"
elif command -v cursor &> /dev/null; then
    cursor "$FILE"
elif command -v vim &> /dev/null; then
    vim "$FILE"
fi
